<%-- OWNER: Member 3 (Order Placement & Tracking). Included in orders.jsp; "o" is current order --%>
<div class="tracking-timeline-box">
  <c:choose>
    <c:when test="${o.status == 'Cancelled'}">
      <div class="tracking-cancelled-banner">
        <span>🚫</span>
        <div>
          <strong>This order has been cancelled</strong>
          <small>No further actions or delivery will take place.</small>
        </div>
      </div>
    </c:when>
    <c:otherwise>
      <c:set var="stepNo" value="${o.status == 'Pending' ? 1 : (o.status == 'Preparing' ? 2 : (o.status == 'On the way' ? 3 : 4))}"/>
      <div class="timeline-stepper">
        <div class="timeline-step ${stepNo >= 1 ? 'completed' : ''} ${stepNo == 1 ? 'current' : ''}">
          <div class="timeline-node">1</div>
          <div class="timeline-label">Order Placed</div>
        </div>
        <div class="timeline-line ${stepNo >= 2 ? 'active' : ''}"></div>
        <div class="timeline-step ${stepNo >= 2 ? 'completed' : ''} ${stepNo == 2 ? 'current' : ''}">
          <div class="timeline-node">2</div>
          <div class="timeline-label">Kitchen Preparing</div>
        </div>
        <div class="timeline-line ${stepNo >= 3 ? 'active' : ''}"></div>
        <div class="timeline-step ${stepNo >= 3 ? 'completed' : ''} ${stepNo == 3 ? 'current' : ''}">
          <div class="timeline-node">3</div>
          <div class="timeline-label">On The Way</div>
        </div>
        <div class="timeline-line ${stepNo >= 4 ? 'active' : ''}"></div>
        <div class="timeline-step ${stepNo >= 4 ? 'completed' : ''} ${stepNo == 4 ? 'current' : ''}">
          <div class="timeline-node">4</div>
          <div class="timeline-label">Delivered</div>
        </div>
      </div>
      <c:if test="${o.status == 'Pending' and queuePos[o.id] gt 0}">
        <div class="queue-status-pill">
          <span>⏳ Kitchen Queue:</span> Order is waiting at position <strong>#${queuePos[o.id]}</strong>
        </div>
      </c:if>
    </c:otherwise>
  </c:choose>
</div>
