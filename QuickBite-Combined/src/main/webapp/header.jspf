<c:set var="ctx" value="${pageContext.request.contextPath}"/>
<header class="nav-header">
  <div class="nav-inner">
    <!-- Brand Logo -->
    <a class="brand-logo" href="${ctx}/foods">
      <span class="brand-mark">Q</span>QuickBite
    </a>

    <!-- Search Form -->
    <form class="nav-search" action="${ctx}/foods" method="get" role="search">
      <span class="nav-search-icon">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
        </svg>
      </span>
      <input class="nav-search-input" type="search" name="q" value="<c:out value='${param.q}'/>" placeholder="Search kottu, burgers, desserts..." aria-label="Search food">
    </form>

    <!-- Desktop Nav Actions -->
    <nav class="nav-actions" aria-label="Main navigation">
      <a class="nav-link" href="${ctx}/foods">Menu</a>
      <c:choose>
        <c:when test="${sessionScope.user.admin}">
          <a class="nav-link" href="${ctx}/orders">All orders</a>
          <a class="nav-link" href="${ctx}/delivery">Delivery</a>
          <a class="nav-link" href="${ctx}/billing">Billing</a>
          <a class="nav-link" href="${ctx}/reports">Reports</a>
          <a class="nav-link" href="${ctx}/users?action=list">Users</a>
          <a class="btn btn-primary btn-sm" href="${ctx}/foods?action=new">+ Add food</a>
        </c:when>
        <c:otherwise>
          <c:if test="${not empty sessionScope.user}">
            <a class="nav-link" href="${ctx}/orders">My orders</a>
          </c:if>
          <!-- Cart Icon Button with Badge -->
          <a class="cart-btn" href="${ctx}/cart" aria-label="Cart">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M3 4h2l2.4 11h10.2L20 8H6.2"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/>
            </svg>
            <span class="cart-badge ${sessionScope.cart.count > 0 ? 'pulse' : ''}">${empty sessionScope.cart ? 0 : sessionScope.cart.count}</span>
          </a>
        </c:otherwise>
      </c:choose>

      <!-- Theme Toggle -->
      <button class="theme-toggle-btn" type="button" aria-label="Toggle dark mode">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>

      <!-- User Auth State -->
      <c:choose>
        <c:when test="${not empty sessionScope.user}">
          <!-- User Avatar Circle & Dropdown (Part C) -->
          <div class="user-menu-wrapper">
            <button class="user-avatar-btn" id="userAvatarBtn" type="button" aria-expanded="false" aria-haspopup="true">
              <span class="user-avatar-circle" style="background-color: ${sessionScope.user.avatarColor};">
                <c:out value="${sessionScope.user.avatarInitial}"/>
              </span>
              <span class="user-avatar-name"><c:out value="${sessionScope.user.username}"/></span>
              <c:if test="${sessionScope.user.admin}"><span class="admin-tag">Admin</span></c:if>
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="user-dropdown" id="userDropdown" role="menu">
              <div class="dropdown-user-info">
                <div class="dropdown-user-name"><c:out value="${sessionScope.user.username}"/></div>
                <div class="dropdown-user-role"><c:out value="${sessionScope.user.role}"/> &middot; <c:out value="${sessionScope.user.email}"/></div>
              </div>
              <a class="dropdown-item" href="${ctx}/users?action=profile" role="menuitem">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                My Profile
              </a>
              <c:if test="${not sessionScope.user.admin}">
                <a class="dropdown-item" href="${ctx}/orders" role="menuitem">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  My Orders
                </a>
              </c:if>
              <c:if test="${sessionScope.user.admin}">
                <div class="dropdown-divider"></div>
                <a class="dropdown-item" href="${ctx}/foods?action=new" role="menuitem">+ Add Food Dish</a>
                <a class="dropdown-item" href="${ctx}/orders" role="menuitem">Manage Orders</a>
                <a class="dropdown-item" href="${ctx}/reports" role="menuitem">View Reports</a>
              </c:if>
              <div class="dropdown-divider"></div>
              <a class="dropdown-item" href="${ctx}/users?action=logout" role="menuitem" style="color: var(--brand);">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Log out
              </a>
            </div>
          </div>
        </c:when>
        <c:otherwise>
          <a class="nav-link" href="${ctx}/users">Log in</a>
          <a class="btn btn-primary btn-sm" href="${ctx}/users?action=register">Sign up</a>
        </c:otherwise>
      </c:choose>
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button class="mobile-nav-toggle" id="mobileNavToggle" type="button" aria-label="Toggle navigation menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer Menu -->
  <div class="nav-mobile-menu" id="mobileNavMenu">
    <a class="nav-link" href="${ctx}/foods">Menu</a>
    <c:choose>
      <c:when test="${sessionScope.user.admin}">
        <a class="nav-link" href="${ctx}/orders">All orders</a>
        <a class="nav-link" href="${ctx}/delivery">Delivery</a>
        <a class="nav-link" href="${ctx}/billing">Billing</a>
        <a class="nav-link" href="${ctx}/reports">Reports</a>
        <a class="nav-link" href="${ctx}/users?action=list">Users</a>
        <a class="nav-link" href="${ctx}/foods?action=new">+ Add food</a>
        <a class="nav-link" href="${ctx}/users?action=profile">Profile (<c:out value="${sessionScope.user.username}"/>)</a>
        <a class="nav-link" href="${ctx}/users?action=logout" style="color: var(--brand);">Log out</a>
      </c:when>
      <c:when test="${not empty sessionScope.user}">
        <a class="nav-link" href="${ctx}/cart">Cart (${empty sessionScope.cart ? 0 : sessionScope.cart.count})</a>
        <a class="nav-link" href="${ctx}/orders">My orders</a>
        <a class="nav-link" href="${ctx}/users?action=profile">Profile (<c:out value="${sessionScope.user.username}"/>)</a>
        <a class="nav-link" href="${ctx}/users?action=logout" style="color: var(--brand);">Log out</a>
      </c:when>
      <c:otherwise>
        <a class="nav-link" href="${ctx}/cart">Cart (${empty sessionScope.cart ? 0 : sessionScope.cart.count})</a>
        <a class="nav-link" href="${ctx}/users">Log in</a>
        <a class="btn btn-primary block" href="${ctx}/users?action=register">Sign up</a>
      </c:otherwise>
    </c:choose>
  </div>
</header>

<!-- Flash notification hook for app.js toast system -->
<c:if test="${not empty param.msg}">
  <div class="container flash-wrap">
    <div class="flash"><c:out value="${param.msg}"/></div>
  </div>
</c:if>
