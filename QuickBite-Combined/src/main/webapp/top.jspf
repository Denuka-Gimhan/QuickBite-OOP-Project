<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><c:out value="${pageTitle}"/> | QuickBite</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Nunito+Sans:ital,wght@0,400;0,600;0,700;0,800;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css">
<c:if test="${not empty extraCss}"><link rel="stylesheet" href="${pageContext.request.contextPath}/css/${extraCss}"></c:if>
<script src="${pageContext.request.contextPath}/js/app.js" defer></script>
<c:if test="${not empty extraJs}"><script src="${pageContext.request.contextPath}/js/${extraJs}" defer></script></c:if>
</head>
